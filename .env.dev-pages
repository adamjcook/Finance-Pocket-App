# Used by the Finance-Pocket-App-dev repo's own deploy workflow, which
# checks out this repo's `develop` branch and runs `npm run build:dev`
# (i.e. `vite build --mode dev-pages`). Deployed to its own sibling GitHub
# Pages site — not a /dev/ sub-path of the real app's own URL, because a
# PWA's scope covers its whole sub-tree: nesting it under the real app's
# path made Chrome treat it as already covered by the real app's install
# ("already installed, open instead") instead of offering a separate one.
# It also gets its own IndexedDB database name, so it can never touch real
# data even though both sites share the adamjcook.github.io origin.
VITE_APP_LABEL=FinPair Dev
VITE_BASE_PATH=/Finance-Pocket-App-dev/
VITE_DB_NAME=finance-pocket-dev
VITE_DEV_BUILD=1
