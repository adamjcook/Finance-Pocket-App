# Mock-data dev build (`npm run build:dev`, i.e. `vite build --mode dev-pages`).
# A Cloudflare Worker builds this from `develop` on every push and serves it
# from the root of its own workers.dev domain — a separate origin from the real app,
# so it installs as its own PWA and can't see the real app's storage.
VITE_APP_LABEL=FinPair Dev
VITE_BASE_PATH=/
VITE_DB_NAME=finance-pocket-dev
VITE_DEV_BUILD=1
