# Used only by the GitHub Pages workflow's dev-environment build step
# (`npm run build:dev`, i.e. `vite build --mode dev-pages`). Deployed under
# /Finance-Pocket-App/dev/ alongside the real app, but with its own IndexedDB
# database so it can never touch real data even though it shares the origin.
VITE_APP_LABEL=FinPair Dev
VITE_BASE_PATH=/Finance-Pocket-App/dev/
VITE_DB_NAME=finance-pocket-dev
VITE_DEV_BUILD=1
