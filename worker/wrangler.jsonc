{
  // Trading 212 daily-reading Worker — separate from the dev-site Worker in
  // ../wrangler.jsonc. Deployed by Cloudflare Workers Builds with the root
  // directory set to `worker` (see README → "Trading 212 link").
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "finpair-t212",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  // Crons are UTC, so each UK time is scheduled at both its GMT and BST hour;
  // the Worker ignores runs that don't land on the right UK hour.
  //   9pm UK: Trading 212 reading (every 15 min through the hour = retries)
  //   9am UK: 0% deal reminders, morning payday reminders
  //   4:30pm UK: payday reminders for pay that lands from 4pm
  "triggers": { "crons": ["*/15 20,21 * * *", "0 8,9 * * *", "30 15,16 * * *"] },
  // One record per day plus a status record. No id: Wrangler creates the
  // namespace on first deploy.
  "kv_namespaces": [{ "binding": "DAYS" }],
  "vars": {
    "ALLOWED_ORIGINS": "https://adamjcook.github.io,https://finpair.mail-ajcook.workers.dev"
  },
  "observability": { "enabled": true }
}
